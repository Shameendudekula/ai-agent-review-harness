# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL connection. postgres://, postgresql:// and postgresql+psycopg:// are accepted.
DATABASE_URL=postgresql+psycopg://localhost/review_harness

# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Requests per minute per client for state-changing endpoints (0 disables).
RATE_LIMIT_PER_MINUTE=60

# Planner: "mock" (deterministic, no API key) or "anthropic" (requires a key).
PLANNER=mock
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_OUTPUT_TOKENS=16000
